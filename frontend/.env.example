# Copy to .env and fill in. .env is gitignored, never commit real values.

# Firebase web app config (Firebase console > Project settings > Your apps)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firestore collections per target:
# local = pnpm start, beta = pnpm build / deploy, prd = pnpm build:prd / deploy:prd
FIRESTORE_SONGS_COLLECTION_LOCAL=songs-test
FIRESTORE_USER_DATA_COLLECTION_LOCAL=user-data-test
FIRESTORE_SONGS_COLLECTION_BETA=songs-test
FIRESTORE_USER_DATA_COLLECTION_BETA=user-data-test
FIRESTORE_SONGS_COLLECTION_PRD=songs
FIRESTORE_USER_DATA_COLLECTION_PRD=user-data

# Deployment (deploy.js)
S3_BUCKET_BETA=beta.codex.brussels
S3_BUCKET_PRD=codex.brussels
AWS_REGION=eu-west-3
# Credentials come from the standard AWS chain (AWS_PROFILE, SSO, ...) or, if you prefer:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
