# Copy to .env and fill in. .env is gitignored, never commit real values.

# Firebase web app config (Firebase console > Project settings > Your apps)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firestore collections per target. The codex collection holds one document per edition,
# with songs/ and clubs/ subcollections (see scripts/import-edition.mjs):
# local = pnpm start, beta = pnpm build / deploy, prd = pnpm build:prd / deploy:prd
FIRESTORE_CODEX_COLLECTION_LOCAL=codex-test
FIRESTORE_USER_DATA_COLLECTION_LOCAL=user-data-test
FIRESTORE_CODEX_COLLECTION_BETA=codex-test
FIRESTORE_USER_DATA_COLLECTION_BETA=user-data-test
FIRESTORE_CODEX_COLLECTION_PRD=codex
FIRESTORE_USER_DATA_COLLECTION_PRD=user-data

# Service account JSON for scripts/import-edition.mjs (keep it outside the repo).
# Leave empty to use GOOGLE_APPLICATION_CREDENTIALS or gcloud application-default credentials.
FIREBASE_SERVICE_ACCOUNT=

# Deployment (deploy.js)
S3_BUCKET_BETA=beta.codex.brussels
S3_BUCKET_PRD=codex.brussels
AWS_REGION=eu-west-3
# Credentials come from the standard AWS chain (AWS_PROFILE, SSO, ...) or, if you prefer:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
